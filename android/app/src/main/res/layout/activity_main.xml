<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A B INFOTECH"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANDROID DIGITAL SIGNER SUITE"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Port 5000"
                android:textColor="#10B981"
                android:background="@drawable/badge_online"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 1: Background Server Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_title"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServerIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Running on: http://127.0.0.1:5000"
                android:textColor="#0DCAF0"
                android:textSize="13sp"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/tvLanIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network IP: Discovering..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnToggleServer"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Stop Server"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnOpenStudio"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.3"
                    android:text="@string/btn_open_studio"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: Certificate Management -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cert_manager_title"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCertCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Installed Certificates: 0"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnImportCert"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/btn_import_cert"
                android:textColor="#38BDF8"
                android:background="@drawable/btn_tool"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 3: License & Activation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/license_title"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLicenseStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Active PRO Edition"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <EditText
                android:id="@+id/etLicenseKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Enter License Key / Bypass"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B"
                android:background="#1E293B"
                android:padding="10dp"
                android:textSize="13sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_activate"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Support Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A B INFOTECH Official Support: +91 7016797720
Website: https://www.a-b-infotech.in"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>