# PyInstaller build outputs
build/
dist/
*.spec

# Python cache & logs
__pycache__/
*.py[cod]
*$py.class
*.log
.system_generated/

# Sensitive PFX / P12 certificate files (never commit user private keys to GitHub)
*.p12
*.pfx
!android/app/src/main/assets/certificates/default_abinfo_dsc.p12
cert_base64.txt

# Large zip & executable files
*.zip
*.tar.gz
*.exe
downloads/
WhatsApp_Browser_Data/
test_stamp_*.png

# Android build outputs & local keystore
android/build_output/
android/**/build/
android/.gradle/
android/temp_reference_files/
temp_reference_files/
*.keystore

# Local OS metadata
Thumbs.db
.DS_Store
